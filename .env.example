# MongoDB Atlas կամ տեղական Mongo connection string (միակ պարտադիր env)։
MONGODB_URI=

# --- Admin panel credentials (պարտադիր /adminPanel-ի համար)։
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Google Drive նկարների բեռնում։
# OAuth2 credentials — Google Cloud Console → Credentials → OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token — OAuth Playground (developers.google.com/oauthplayground)
GOOGLE_OAUTH_REFRESH_TOKEN=
# Մայր թղթապանակի ID — Drive-ում թղթապանակի URL-ից վերջին մասը
DRIVE_UPLOAD_PARENT_FOLDER_ID=
